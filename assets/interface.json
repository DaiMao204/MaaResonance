{
    "interface_version": 2,
    "name": "MaaResonance",
    "label": "MaaResonance",
    "title": "MaaResonance",
    "description": "基于 MaaFramework 的 Resonance 自动化辅助项目。",
    "contact": "Issues: https://github.com/DaiMao204/MaaResonance/issues",
    "license": "AGPL-3.0-only",
    "welcome": "当前处于公开测试阶段，主要测试功能稳定性。遇到异常请附带 MXU 日志、任务配置和出错界面截图反馈。",
    "github": "https://github.com/DaiMao204/MaaResonance",
    "version": "v2.0.0-beta.2",
    "mirrorchyan_rid": "MaaResonance",
    "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "ADB",
            "label": "安卓模拟器",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "Win32",
            "label": "PC 客户端（前台）",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "^UnityWndClass$",
                "window_regex": "^雷索纳斯$",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            },
            "attach_resource_path": [
                "./resource/pc"
            ]
        },
        {
            "name": "Win32BackgroundWindowPos",
            "label": "PC 客户端（后台-移窗不抢鼠标）",
            "description": "不移动物理鼠标，点击或滑动时会短暂平移后台游戏窗口对齐光标（游戏窗口可被遮挡但不可最小化）。",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "^UnityWndClass$",
                "window_regex": "^雷索纳斯$",
                "screencap": "FramePool",
                "mouse": "PostMessageWithWindowPos",
                "keyboard": "PostMessage"
            },
            "attach_resource_path": [
                "./resource/pc"
            ]
        },
        {
            "name": "Win32BackgroundCursorPos",
            "label": "PC 客户端（后台-移光标）",
            "description": "游戏窗口保持原位不动，点击或滑动瞬间短暂借用并复位物理鼠标（游戏窗口可被遮挡但不可最小化）。",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "^UnityWndClass$",
                "window_regex": "^雷索纳斯$",
                "screencap": "FramePool",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessage"
            },
            "attach_resource_path": [
                "./resource/pc"
            ]
        }
    ],
    "resource": [
        {
            "name": "official",
            "label": "官服",
            "path": [
                "./resource/base"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "identifier": "maa_resonance_agent",
        "child_args": [
            "-u",
            "../agent/main.py"
        ]
    },
    "group": [
        {
            "name": "account",
            "label": "账号配置"
        },
        {
            "name": "trade",
            "label": "跑商"
        },
        {
            "name": "daily",
            "label": "日常"
        },
        {
            "name": "experimental",
            "label": "实验与原子工具"
        },
        {
            "name": "system",
            "label": "系统"
        }
    ],
    "task": [],
    "option": {},
    "preset": [
        {
            "name": "daily-all-in-one",
            "label": "一键自动日常",
            "description": "拆分为独立可勾选、可调顺序的完整日常流程：开始唤醒 -> 前置收菜与签到 -> 自动商店采购 -> 共斗众志攻坚 -> 限时活动刷关清澄明度 -> 糖霜记忆每日取景 -> [可选]自动跑商 -> 每日活跃与通行证收尾领奖。",
            "task": [
                {
                    "name": "WakeUp",
                    "enabled": true
                },
                {
                    "name": "DailyPrep",
                    "enabled": true
                },
                {
                    "name": "AutoShop",
                    "enabled": true
                },
                {
                    "name": "CoopAssault",
                    "enabled": true
                },
                {
                    "name": "EventStageFarm",
                    "enabled": true
                },
                {
                    "name": "EventStoryDaily",
                    "enabled": true
                },
                {
                    "name": "AutoTwoCityBusiness",
                    "enabled": false,
                    "option": {
                        "AutoTwoCityPriorityCity1": "none",
                        "AutoTwoCityPriorityCity2": "none",
                        "AutoTwoCityExcludeCities": [],
                        "AutoTwoCityPlannerParams": {
                            "max_restock": "6"
                        },
                        "ManualTwoCityUseHaggleBook": "No",
                        "ManualTwoCityWulinyuanEnabled": "Yes",
                        "AutoTwoCityWulinyuanPriority": "total",
                        "ManualTwoCityRunMode": "until_fatigue_exhausted",
                        "ManualTwoCityAccountProfileReadMode": "smart",
                        "ManualTwoCityAutoImpactDrill": "Yes",
                        "ManualTwoCityAutoSpeedProjectile": "Yes",
                        "ManualTwoCityAutoPickup": "No",
                        "ManualTwoCityAutoDrink": "Yes",
                        "ManualTwoCityAutoBento": "Yes",
                        "ManualTwoCityUseMedicine": "No"
                    }
                },
                {
                    "name": "DailyClaim",
                    "enabled": true
                }
            ]
        },
        {
            "name": "daily-routine",
            "label": "自动日常（轻量整合）",
            "description": "兼容整合入口：自动执行邮箱一键领取、派遣委托收菜与再次委托、好友名片支援金币、限时活动启程签到、营收排行榜全部玩家点赞 3 次、导航手册「每日活跃」点数与 100~600 宝箱领取，以及环游手册（通行证）每日/每周任务与等级奖励领取。",
            "task": [
                {
                    "name": "DailyRoutine",
                    "enabled": true
                }
            ]
        },
        {
            "name": "auto-business",
            "label": "自动跑商",
            "description": "在安卓模拟器中启动游戏，自动规划并执行双城跑商。",
            "task": [
                {
                    "name": "LaunchGame",
                    "enabled": true
                },
                {
                    "name": "AutoTwoCityBusiness",
                    "enabled": true,
                    "option": {
                        "AutoTwoCityPriorityCity1": "none",
                        "AutoTwoCityPriorityCity2": "none",
                        "AutoTwoCityExcludeCities": [],
                        "AutoTwoCityPlannerParams": {
                            "max_restock": "6"
                        },
                        "ManualTwoCityUseHaggleBook": "No",
                        "ManualTwoCityWulinyuanEnabled": "Yes",
                        "AutoTwoCityWulinyuanPriority": "total",
                        "ManualTwoCityRunMode": "until_fatigue_exhausted",
                        "ManualTwoCityAccountProfileReadMode": "smart",
                        "ManualTwoCityAutoImpactDrill": "Yes",
                        "ManualTwoCityAutoSpeedProjectile": "Yes",
                        "ManualTwoCityAutoPickup": "No",
                        "ManualTwoCityAutoDrink": "Yes",
                        "ManualTwoCityAutoBento": "Yes",
                        "ManualTwoCityUseMedicine": "No"
                    }
                }
            ]
        },
        {
            "name": "manual-business",
            "label": "手动跑商",
            "description": "在安卓模拟器中启动游戏，按指定起点和目标城市执行双城跑商。",
            "task": [
                {
                    "name": "LaunchGame",
                    "enabled": true
                },
                {
                    "name": "ManualTwoCityBusiness",
                    "enabled": true,
                    "option": {
                        "ManualTwoCityStartCity": "修格里城",
                        "ManualTwoCityStartParams": {
                            "start_book": "2",
                            "start_bargain_percent": "20",
                            "start_raise_percent": "20"
                        },
                        "ManualTwoCityTargetCity": "7号自由港",
                        "ManualTwoCityTargetParams": {
                            "target_book": "2",
                            "target_bargain_percent": "20",
                            "target_raise_percent": "20"
                        },
                        "ManualTwoCityUseHaggleBook": "No",
                        "ManualTwoCityWulinyuanEnabled": "Yes",
                        "ManualTwoCityRunMode": "until_fatigue_exhausted",
                        "ManualTwoCityAccountProfileReadMode": "smart",
                        "ManualTwoCityAutoImpactDrill": "Yes",
                        "ManualTwoCityAutoSpeedProjectile": "Yes",
                        "ManualTwoCityAutoPickup": "No",
                        "ManualTwoCityAutoDrink": "Yes",
                        "ManualTwoCityAutoBento": "Yes",
                        "ManualTwoCityUseMedicine": "No"
                    }
                }
            ]
        },
        {
            "name": "pc-manual-business",
            "label": "PC 手动跑商（一轮）",
            "description": "从已打开的国服 PC 客户端执行一轮往返，去程和回程均使用 0 本进货书。",
            "task": [
                {
                    "name": "ManualTwoCityBusiness",
                    "enabled": true,
                    "option": {
                        "ManualTwoCityStartCity": "修格里城",
                        "ManualTwoCityStartParams": {
                            "start_book": "0",
                            "start_bargain_percent": "0",
                            "start_raise_percent": "0"
                        },
                        "ManualTwoCityTargetCity": "7号自由港",
                        "ManualTwoCityTargetParams": {
                            "target_book": "0",
                            "target_bargain_percent": "0",
                            "target_raise_percent": "0"
                        },
                        "ManualTwoCityRunMode": "one_round",
                        "ManualTwoCityAccountProfileReadMode": "none",
                        "ManualTwoCityUseHaggleBook": "No",
                        "ManualTwoCityWulinyuanEnabled": "No",
                        "ManualTwoCityAutoImpactDrill": "No",
                        "ManualTwoCityAutoSpeedProjectile": "No",
                        "ManualTwoCityAutoPickup": "No",
                        "ManualTwoCityAutoDrink": "No",
                        "ManualTwoCityAutoBento": "No",
                        "ManualTwoCityUseMedicine": "No"
                    }
                }
            ]
        }
    ],
    "import": [
        "resource/tasks/WakeUp.json",
        "resource/tasks/DailyPrep.json",
        "resource/tasks/AutoShop.json",
        "resource/tasks/CoopAssault.json",
        "resource/tasks/EventStageFarm.json",
        "resource/tasks/EventStoryDaily.json",
        "resource/tasks/DailyClaim.json",
        "resource/tasks/DailyRoutine.json",
        "resource/tasks/ManualTwoCityBusiness.json",
        "resource/tasks/AutoTwoCityBusiness.json",
        "resource/tasks/StorySkip.json",
        "resource/tasks/AutoTeamFormation.json",
        "resource/tasks/AutoBattle.json",
        "resource/tasks/LaunchGame.json"
    ]
}
