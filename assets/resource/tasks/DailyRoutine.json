{
    "task": [
        {
            "name": "DailyRoutine",
            "label": "自动日常（轻量整合）",
            "entry": "DailyRoutineStart",
            "description": "兼容整合入口：邮箱一键领取、派遣委托收菜与再次委托、好友名片支援奖励、限时活动启程签到、营收排行榜全部玩家点赞 3 次、导航手册「每日活跃」点数与 100~600 宝箱领取，以及环游手册（通行证）每日/每周任务与等级奖励领取。",
            "group": [
                "daily"
            ],
            "resource": [
                "official"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "option": [
                "DailyMailEnabled",
                "DailyDispatchEnabled",
                "DailyFriendSupportEnabled",
                "DailyEventCheckinEnabled",
                "DailyRevenueLikeEnabled",
                "DailyActivityClaimEnabled",
                "DailyBattlePassEnabled"
            ]
        }
    ],
    "option": {
        "DailyMailEnabled": {
            "type": "switch",
            "label": "邮箱一键领取",
            "description": "从左下角头像抽屉进入邮箱并点击右下角「一键领取」（不碰「删除已读」）。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRoutineMailStep": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRoutineMailStep": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyDispatchEnabled": {
            "type": "switch",
            "label": "派遣委托收菜",
            "description": "进入「委托」领取已完成委托奖励，可配置是否在委托报告弹窗点击「再次委托」。不会点击「立即完成」或「召回」。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "DailyDispatchReassign"
                    ],
                    "pipeline_override": {
                        "DailyRoutineDispatchStep": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRoutineDispatchStep": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyDispatchReassign": {
            "type": "switch",
            "label": "领取后自动再次委托",
            "description": "开启则在「委托报告」弹窗点击「再次委托」一键续派；关闭则仅点击「关闭」。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRoutineDispatchStep": {
                            "custom_action_param": {
                                "reassign": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRoutineDispatchStep": {
                            "custom_action_param": {
                                "reassign": false
                            }
                        }
                    }
                }
            ]
        },
        "DailyFriendSupportEnabled": {
            "type": "switch",
            "label": "好友名片支援金币奖励",
            "description": "打开左下抽屉进入好友/名片界面，自动领取助战金币气泡（如 40K）。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRoutineFriendSupportStep": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRoutineFriendSupportStep": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyEventCheckinEnabled": {
            "type": "switch",
            "label": "限时活动启程签到",
            "description": "进入「活动 -> 限时活动 -> 启程签到」，检测到红点或亮框可领卡片时自动点击领取。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRoutineEventCheckinStep": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRoutineEventCheckinStep": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyRevenueLikeEnabled": {
            "type": "switch",
            "label": "营收排行榜点赞 3 次",
            "description": "进入营收排行榜并切换至「全部玩家」页签，依次点赞直至达到每日 3/3 上限。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRoutineRevenueLikeStep": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRoutineRevenueLikeStep": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyActivityClaimEnabled": {
            "type": "switch",
            "label": "每日活跃领奖与宝箱",
            "description": "进入「导航手册 -> 每日活跃」，领取已完成任务活跃度并点击所有已点亮的 100~600 宝箱。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRoutineActivityStep": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRoutineActivityStep": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyBattlePassEnabled": {
            "type": "switch",
            "label": "环游手册（通行证）领奖",
            "description": "在日常末尾进入「环游手册」，遍历左侧各通行证分别领取「每日任务」「每周任务」及等级奖励（不会点击购买等级或进阶）。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRoutineBattlePassStep": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRoutineBattlePassStep": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
