{
    "task": [
        {
            "name": "AutoShop",
            "label": "自动商店采购（周期）",
            "entry": "AutoShopStart",
            "description": "按 UID + 刷新周期（05:00 日/周/月）自动执行三层商店优先级采购：① 黑月总部商店（铁盟币，可选采购券，硬屏蔽桦石）；② 赴命商店（仅周期限购，默认仅紫章）；③ 商会里程点数兑换（仅本周/本月限购，非城市站点安全跳过）。每项均做商品名/货币/保留余额二次核验。",
            "group": [
                "daily"
            ],
            "resource": [
                "official"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "option": [
                "AutoShopScheduleMode",
                "AutoShopBlackMoonHqEnabled",
                "AutoShopFumingEnabled",
                "AutoShopChamberEnabled"
            ]
        }
    ],
    "option": {
        "AutoShopScheduleMode": {
            "type": "select",
            "label": "周期触发与防重复策略",
            "description": "默认按 UID 在 config/auto_shop_state.json 自动计算并记录下次运行时间（05:00 日/周/月重置；改动清单会自动重查）。选择「立即运行」可跳过冷却直接检查全部分店。",
            "default_case": "Smart",
            "cases": [
                {
                    "name": "Smart",
                    "label": "按 UID 自动记录下次运行时间（推荐）",
                    "pipeline_override": {
                        "AutoShopOptScheduleMode": {
                            "attach": {
                                "schedule_mode": "smart"
                            }
                        }
                    }
                },
                {
                    "name": "ForceRun",
                    "label": "立即运行（忽略本周期缓存强制检查）",
                    "pipeline_override": {
                        "AutoShopOptScheduleMode": {
                            "attach": {
                                "schedule_mode": "force"
                            }
                        }
                    }
                }
            ]
        },
        "AutoShopBlackMoonHqEnabled": {
            "type": "switch",
            "label": "① 启用黑月总部商店采购",
            "description": "进入「商城 -> 总部商店」，按优先级购买清单商品（严格屏蔽所有桦石消耗项）。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "AutoShopHqGoldItems",
                        "AutoShopHqGoldConfig",
                        "AutoShopHqTicketEnabled"
                    ],
                    "pipeline_override": {
                        "AutoShopOptBlackMoonHqEnabled": {
                            "attach": {
                                "hq_enabled": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoShopOptBlackMoonHqEnabled": {
                            "attach": {
                                "hq_enabled": false
                            }
                        }
                    }
                }
            ]
        },
        "AutoShopHqGoldItems": {
            "type": "checkbox",
            "label": "黑月总部 · 铁盟币购买清单（按从上到下优先级）",
