        "AutoShopHqGoldConfig": {
            "type": "input",
            "label": "黑月总部 · 铁盟币保留线与限购/补充规则",
            "description": "补充框平时留空即可。支持 *N 原地限购（例：提神棒棒糖:周*3，按原勾选优先级只买到第3个）、^ 显式置顶（例：^进货采买书:周）或填新增商品（逗号分隔）。",
            "inputs": [
                {
                    "name": "hq_gold_reserve",
                    "label": "铁盟币最低保留下限",
                    "default": "3000000",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9]\\d*)$",
                    "pattern_msg": "请输入大于等于 0 的非负整数。"
                },
                {
                    "name": "hq_gold_extra",
                    "label": "单品限量 / ^置顶 / 新增商品（选填）",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "AutoShopOptHqGoldConfig": {
                    "attach": {
                        "hq_gold_reserve": "{hq_gold_reserve}",
                        "hq_gold_extra": "{hq_gold_extra}",
                        "hq_gold_ui_configured": true
                    }
                }
            }
        },
        "AutoShopHqTicketEnabled": {
            "type": "switch",
            "label": "允许黑月总部使用「黑月采购券」",
            "description": "默认关闭以保护稀有采购券（独奏/回响/本源之弦、独石碎片等）；开启后才按下方清单兑换。",
